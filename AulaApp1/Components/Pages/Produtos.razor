@page "/produtos"

<PageTitle>Produtos</PageTitle>

<h3 class="mb-4">Produtos</h3>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card card-body">
            <h5 class="card-title mb-3">Cadastrar produto</h5>

            <EditForm @key="contextoFormulario" EditContext="contextoFormulario"
                      OnValidSubmit="AdicionarProduto">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="nomeProduto" class="form-label">Nome</label>
                    <InputText id="nomeProduto" class="form-control"
                               @bind-Value="produtoAtual.Nome" />
                    <ValidationMessage For="@(() => produtoAtual.Nome)" />
                </div>

                <div class="mb-3">
                    <label for="precoProduto" class="form-label">Preço</label>
                    <InputNumber id="precoProduto" class="form-control"
                                 @bind-Value="produtoAtual.Preco" step="0.01" min="0.01" />
                    <ValidationMessage For="@(() => produtoAtual.Preco)" />
                </div>

                <div class="mb-3">
                    <label for="quantidadeProduto" class="form-label">Quantidade</label>
                    <InputNumber id="quantidadeProduto" class="form-control"
                                 @bind-Value="produtoAtual.Quantidade" min="0" />
                    <ValidationMessage For="@(() => produtoAtual.Quantidade)" />
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Adicionar produto
                </button>
            </EditForm>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-body">
            <h5 class="card-title mb-3">Produtos cadastrados</h5>

            @if (produtos.Count == 0)
            {
                <p class="text-muted mb-0">Nenhum produto cadastrado.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Nome</th>
                                <th>Preço</th>
                                <th>Quantidade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in produtos)
                            {
                                <tr>
                                    <td>@item.Nome</td>
                                    <td>@item.Preco.ToString("C")</td>
                                    <td>@item.Quantidade</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private Produto produtoAtual = new();
    private EditContext contextoFormulario = default!;
    private readonly List<Produto> produtos = new();

    protected override void OnInitialized()
    {
        contextoFormulario = new EditContext(produtoAtual);
    }

    private void AdicionarProduto()
    {
        produtos.Add(new Produto
        {
            Nome = produtoAtual.Nome.Trim(),
            Preco = produtoAtual.Preco,
            Quantidade = produtoAtual.Quantidade
        });

        produtoAtual = new Produto();
        contextoFormulario = new EditContext(produtoAtual);
    }
}
